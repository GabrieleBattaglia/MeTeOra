msgid "Riproduzione casuale accesa: {modello}."
msgstr ""

#: finestra.py:592
msgid "Riproduzione casuale spenta: a fine brano si va avanti in ordine."
msgstr ""

#: finestra.py:608
msgid ""
"Volume uniforme spento: ogni file suona con il volume con cui è "
"registrato."
msgstr ""

#: finestra.py:609
msgid ""
"Volume uniforme per brano: i file con i tag ReplayGain si avvicinano allo"
" stesso volume; quelli forti scendono, e quelli piani salgono fin dove i "
"loro picchi lo permettono."
msgstr ""

#: finestra.py:610
msgid ""
"Volume uniforme per album: ogni disco con i tag ReplayGain suona allo "
"stesso volume, e dentro il disco restano le differenze volute."
msgstr ""

#: finestra.py:613
msgid "Ripetizione spenta."
msgstr ""

#: finestra.py:614
msgid "Ripetizione del brano: quando finisce, ricomincia."
